{
  "style": "for-the-badge",
  "sweetSpot": "3-5 status badges per hero row; more reads as clutter",
  "placeholders": {
    "{{OWNER}}": "GitHub org/user, from git remote",
    "{{REPO}}": "GitHub repo name, from git remote",
    "{{PACKAGE}}": "published package name (npm, etc.)",
    "{{WORKFLOW_FILE}}": "CI workflow filename, e.g. ci.yml",
    "{{CHANNEL_ID}}": "YouTube channel ID",
    "{{SERVER_ID}}": "Discord server ID",
    "{{CHANNEL}}": "Twitch channel name",
    "{{HANDLE}}": "Twitter/X handle",
    "{{VANITY}}": "LinkedIn/Bluesky vanity handle"
  },
  "categories": {
    "status": {
      "license": {
        "label": "License",
        "url": "https://img.shields.io/github/license/{{OWNER}}/{{REPO}}?style=for-the-badge",
        "link": "LICENSE"
      },
      "version": {
        "label": "Version",
        "url": "https://img.shields.io/github/package-json/v/{{OWNER}}/{{REPO}}?style=for-the-badge",
        "alt": "https://img.shields.io/npm/v/{{PACKAGE}}?style=for-the-badge",
        "altNote": "use for a published npm package instead of the GitHub-derived version",
        "link": "package.json"
      },
      "ci": {
        "label": "CI",
        "url": "https://img.shields.io/github/actions/workflow/status/{{OWNER}}/{{REPO}}/{{WORKFLOW_FILE}}?style=for-the-badge",
        "link": "../../actions"
      },
      "stars": {
        "label": "Stars",
        "url": "https://img.shields.io/github/stars/{{OWNER}}/{{REPO}}?style=for-the-badge",
        "link": "../../stargazers"
      }
    },
    "social": {
      "youtube": {
        "label": "YouTube",
        "url": "https://img.shields.io/youtube/channel/subscribers/{{CHANNEL_ID}}?style=for-the-badge&logo=youtube&logoColor=white",
        "note": "subscriber count, live"
      },
      "discord": {
        "label": "Discord",
        "url": "https://img.shields.io/discord/{{SERVER_ID}}?style=for-the-badge&logo=discord&logoColor=white&label=Discord",
        "note": "member count, live"
      },
      "twitter": {
        "label": "Twitter/X",
        "url": "https://img.shields.io/badge/Twitter-Follow-1DA1F2?style=for-the-badge&logo=twitter&logoColor=white",
        "note": "static — live follower counts aren't available"
      },
      "linkedin": {
        "label": "LinkedIn",
        "url": "https://img.shields.io/badge/LinkedIn-Connect-0A66C2?style=for-the-badge&logo=linkedin&logoColor=white",
        "note": "static — no public follower-count API"
      },
      "bluesky": {
        "label": "Bluesky",
        "url": "https://img.shields.io/badge/Bluesky-Follow-0285FF?style=for-the-badge&logo=bluesky&logoColor=white",
        "note": "static"
      },
      "twitch": {
        "label": "Twitch",
        "url": "https://img.shields.io/twitch/status/{{CHANNEL}}?style=for-the-badge&logo=twitch&logoColor=white",
        "alt": "https://img.shields.io/twitch/followers/{{CHANNEL}}?style=for-the-badge&logo=twitch&logoColor=white",
        "altNote": "follower count instead of live status"
      }
    },
    "extras": {
      "downloads": {
        "label": "Downloads",
        "url": "https://img.shields.io/npm/dm/{{PACKAGE}}?style=for-the-badge",
        "note": "monthly npm downloads, only for published packages"
      },
      "prsWelcome": {
        "label": "PRs Welcome",
        "url": "https://img.shields.io/badge/PRs-welcome-brightgreen?style=for-the-badge",
        "note": "static, use only if CONTRIBUTING.md actively invites external PRs"
      },
      "contributors": {
        "label": "Contributors",
        "url": "https://img.shields.io/github/contributors/{{OWNER}}/{{REPO}}?style=for-the-badge",
        "link": "../../graphs/contributors"
      }
    }
  },
  "rules": [
    "Only render a badge whose placeholders resolve to real, detected values — never leave a {{PLACEHOLDER}} unresolved in output",
    "status category goes in the hero badge row",
    "social category goes in the Social Links section, only when the link was found in Step 1",
    "extras are optional, add sparingly and only when clearly true of the repo"
  ]
}
